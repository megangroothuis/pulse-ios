# Copy to .env and fill in real values only if you need the (not yet wired-in)
# auth / API features. The app's current screens run entirely on mock data and
# need NONE of these. Never commit .env.
#
# NOTE: every EXPO_PUBLIC_* value is inlined into the JS bundle and is visible
# to anyone with the app. Do not put real secrets in EXPO_PUBLIC_* vars.

# Clerk (auth) — publishable key, pk_test_... from dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (database) — project URL + anon (public) key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Spotify / Strava direct OAuth (src/lib/spotifyAuth.ts, src/lib/stravaAuth.ts)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=
