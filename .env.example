# Copy to .env (gitignored). With both values set the app runs in LIVE mode
# (sign-in + your real sessions); leave them empty for DEMO mode (mock data).
# Full backend setup: BACKEND_SETUP.md
#
# Every EXPO_PUBLIC_* value is inlined into the JS bundle and visible to anyone
# with the app. Only the project URL and anon/publishable key belong here.
# Spotify/Strava client secrets are Supabase Edge Function secrets
# (`supabase secrets set ...`), never app env vars.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
