{
  "name": "pulse",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:web": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo start --web --port 8081",
    "typecheck": "tsc -p tsconfig.app.json",
    "build:web": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist/web",
    "build:ios-bundle": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist/ios",
    "smoke": "NODE_PATH=\"$(npm root -g)\" node scripts/smoke-web.cjs",
    "verify": "bash scripts/verify.sh",
    "test:functions": "bash scripts/test-functions.sh",
    "smoke:live": "NODE_PATH=\"$(npm root -g)\" node scripts/smoke-live.cjs"
  },
  "dependencies": {
    "@expo/webpack-config": "^19.0.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^17.2.3",
    "expo": "^54.0.31",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.1.10",
    "@types/react-native": "~0.72.2",
    "typescript": "^5.1.3"
  },
  "private": true
}
